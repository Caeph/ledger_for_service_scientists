# Copy to .env (deploy.sh does this for you and fills in a random ADMIN_PASSWORD).

# Image name and tag
IMAGE=analysis-tracker
TAG=latest

# Where the app listens on the host. 127.0.0.1 = only this machine / a reverse proxy here.
# Use 0.0.0.0 to expose it on the network.
BIND_ADDR=127.0.0.1
APP_PORT=8000

# Host directories. DATA_PATH holds the database and all uploaded files: back it up.
DATA_PATH=./docker-data
# Git repositories for commit-SHA checks (mounted read-only). May stay empty.
REPOS_PATH=./repos

# First-run admin account (only used when the database is empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 1 = load the demo projects on the first run
LOAD_DEMO=0

MAX_UPLOAD_MB=500

# true hardens the container; deploy.sh sets false on snap-packaged Docker, where it stops the container from starting
NO_NEW_PRIVILEGES=

# uid/gid the container runs as; deploy.sh sets these to the owner of DATA_PATH
APP_UID=
APP_GID=
